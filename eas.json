{
  "cli": {
    "version": ">= 16.31.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3001",
        "EXPO_PUBLIC_ORPC_URL": "http://localhost:3001/rpc",
        "EXPO_PUBLIC_AUTH_URL": "http://localhost:3001/api/auth",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:8080",
        "EXPO_PUBLIC_UPLOADS_URL": "http://localhost:3001/uploads"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://my-track-pi3n.onrender.com",
        "EXPO_PUBLIC_ORPC_URL": "https://my-track-pi3n.onrender.com/rpc",
        "EXPO_PUBLIC_AUTH_URL": "https://my-track-pi3n.onrender.com/api/auth",
        "EXPO_PUBLIC_WS_URL": "wss://my-track-pi3n.onrender.com",
        "EXPO_PUBLIC_UPLOADS_URL": "https://my-track-pi3n.onrender.com/uploads"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://my-track-pi3n.onrender.com",
        "EXPO_PUBLIC_ORPC_URL": "https://my-track-pi3n.onrender.com/rpc",
        "EXPO_PUBLIC_AUTH_URL": "https://my-track-pi3n.onrender.com/api/auth",
        "EXPO_PUBLIC_WS_URL": "wss://my-track-pi3n.onrender.com",
        "EXPO_PUBLIC_UPLOADS_URL": "https://my-track-pi3n.onrender.com/uploads"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
